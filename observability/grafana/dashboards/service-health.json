    {
      "id": 10,
      "title": "Committed readings",
      "description": "Complete reading batches committed to the historian, measured as readings per second. A missing scrape leaves a gap.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "well-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(wellhead_readings_written_total{job=\"ingestion\"}[5m]) and on(job, instance) (up == 1))",
          "legendFormat": "Readings / second",
          "datasource": {
            "type": "prometheus",
            "uid": "well-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "axisLabel": "Readings / second"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Time since last commit",
      "description": "Seconds since ingestion last committed a complete batch. It continues increasing during a dependency failure while ingestion remains reachable. Unknown before the first commit.",
