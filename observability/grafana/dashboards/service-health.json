{
  "uid": "well-service-health",
  "title": "Service health",
  "description": "Service reachability, readiness, historian activity and background jobs.",
  "tags": [
    "well-simulation",
    "services"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Read this dashboard",
      "description": "Use the well dashboard for wells, forecasts and scenarios. These panels describe the services that support it.",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "**Reachable:** the endpoint answered. **Ready:** it can do its work. **Unknown:** a current sample is missing."
      }
    },
    {
      "id": 2,
      "title": "Model \u00b7 reachability",
      "description": "Latest scrape result. A missing target shows Unknown.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "well-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"twin-core\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "well-prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Reachable",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "text",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
