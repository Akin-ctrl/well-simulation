    {
      "id": 14,
      "title": "API requests",
      "description": "All HTTP requests, including health checks and scrapes. Grouped by response status.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "well-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(api_http_requests_total{job=\"api\"}[5m]) and on(job, instance) (up == 1))",
          "legendFormat": "HTTP {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "well-prometheus"
          },
          "range": true
        }
      ],
