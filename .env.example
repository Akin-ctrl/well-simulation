# PostgreSQL/TimescaleDB configuration used inside Docker Compose.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wellhead_data
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Modbus configuration.
MODBUS_HOST=modbus
MODBUS_BIND_HOST=0.0.0.0
MODBUS_PORT=5020

# How often the simulator emits a telemetry batch and how often ingestion
# polls for one. These are deliberately the same value: when ingestion polled
# faster than the simulator emitted, every simulated value was recorded to the
# historian multiple times.
TELEMETRY_INTERVAL_SECONDS=5

# pgAdmin local demo credentials.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# API authentication.
JWT_SECRET=change-me-to-a-long-random-local-secret

# Optional local API development value outside Docker Compose.
DATABASE_URL=postgres://admin:change-me@localhost:5434/wellhead_data
