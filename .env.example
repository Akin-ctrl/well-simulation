# PostgreSQL/TimescaleDB configuration used inside Docker Compose.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wellhead_data
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Modbus configuration.
MODBUS_HOST=modbus
MODBUS_BIND_HOST=0.0.0.0
MODBUS_PORT=5020

# How often the simulator emits a telemetry batch and how often ingestion
# polls for one. These are deliberately the same value: when ingestion polled
# faster than the simulator emitted, every simulated value was recorded to the
# historian multiple times.
TELEMETRY_INTERVAL_SECONDS=5

# pgAdmin local demo credentials.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# API authentication.
JWT_SECRET=change-me-to-a-long-random-local-secret

# Optional local API development value outside Docker Compose.
DATABASE_URL=postgres://admin:change-me@localhost:5434/wellhead_data

# Session cookie Secure flag. Keep false for the plain-HTTP local stack; set
# true wherever TLS terminates. Previously inferred from NODE_ENV, which meant
# production-mode containers served over HTTP had their cookies dropped.
COOKIE_SECURE=false

# Hosts allowed to speak for a client via x-forwarded-for, comma separated.
# Empty means trust nothing, which is correct when the API is not behind a
# proxy. The dashboard's nginx container address goes here if it is.
TRUSTED_PROXY_IPS=

# Extra origins permitted to make state-changing requests, comma separated.
# Same-origin is always allowed; the dashboard proxies /api so this stays empty.
ALLOWED_ORIGINS=
