{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "web": {
      "interactive": true,
      "persistent": true,
      "cache": false
    },
    "server": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "JWT_SECRET",
    "SERVER_BASE_URL",
    "COOKIE_SECURE",
    "TRUSTED_PROXY_IPS",
    "ALLOWED_ORIGINS",
    "NODE_ENV"
  ]
}
