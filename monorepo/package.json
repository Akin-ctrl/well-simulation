{
  "name": "corsight",
  "private": true,
  "scripts": {
    "web": "dotenv -- turbo run dev --filter=@corsight/website --filter=@corsight/api",
    "server": "dotenv -- turbo run dev --filter=@corsight/api",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:dto": "vitest run packages/dto/**/*.test.ts",
    "validate:openapi": "python3 ../scripts/validate_openapi.py"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "dotenv-cli": "^10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
