{
  "name": "well-simulation",
  "private": true,
  "scripts": {
    "web": "dotenv -- turbo run dev --filter=@well-simulation/website --filter=@well-simulation/api",
    "server": "dotenv -- turbo run dev --filter=@well-simulation/api",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test:dto": "vitest run packages/dto/**/*.test.ts",
    "validate:openapi": "python3 ../scripts/validate_openapi.py",
    "format:check": "prettier --check .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "dotenv-cli": "^10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
