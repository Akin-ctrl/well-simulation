{
  "name": "well-simulation",
  "private": true,
  "scripts": {
    "web": "dotenv -- turbo run dev --filter=@well-simulation/website --filter=@well-simulation/api",
    "server": "dotenv -- turbo run dev --filter=@well-simulation/api",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test:dto": "vitest run packages/dto/**/*.test.ts",
    "validate:openapi": "python3 ../scripts/validate_openapi.py",
    "format:check": "prettier --check .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.14",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "dotenv-cli": "^10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@babel/core@^7": "^7.29.6",
      "@humanfs/node@^0.16": "^0.16.8",
      "ajv@^6": "^6.14.0",
      "ajv@^8": "^8.18.0",
      "baseline-browser-mapping@^2": "^2.11.0",
      "body-parser@^1": "^1.20.6",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "browserslist@^4": "^4.28.7",
      "diff@^5": "^5.2.2",
      "flatted@^3": "^3.4.2",
      "glob@^10": "^10.5.0",
      "js-cookie@^3": "^3.0.7",
      "js-yaml@^4": "^4.3.2",
      "lodash@^4": "^4.18.0",
      "minimatch@^3": "^3.1.4",
      "minimatch@^9": "^9.0.7",
      "morgan@^1": "^1.12.1",
      "nanoid@^3": "^3.3.18",
      "path-to-regexp@^0.1": "^0.1.13",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "postcss@^8": "^8.5.23",
      "qs@^6": "^6.16.0",
      "rollup@^4": "^4.59.0",
      "vite@^6": "^6.4.3",
      "ws@^8": "^8.21.0",
      "yaml@^1": "^1.10.3"
    }
  }
}
